# /opt/jpcloud-vpsd/.env
# Copier en .env, remplir, puis : chmod 600 .env && chown jpcloud:jpcloud .env

# Le daemon écoute en LOCAL uniquement (127.0.0.1) — Nginx fait le reverse-proxy TLS.
PORT=8899

# openssl rand -hex 32 — doit être IDENTIQUE au réglage vpsd_api_token de wamp64/jpcloud
VPSD_TOKEN=CHANGER

# Interface WireGuard déjà en place sur ce VPS (ne pas modifier sans migrer les pairs).
WG_INTERFACE=wg0

# Dossier de configuration OpenVPN (créé par POST /ovpn/bootstrap si absent).
OVPN_DIR=/etc/openvpn/server
OVPN_SERVICE=openvpn-server@jpcloud
OVPN_STATUS_LOG=/var/log/openvpn/status-jpcloud.log
OVPN_PORT=1194

WG_SERVICE=wg-quick@wg0
